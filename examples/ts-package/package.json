{
	"name": "@scholarspace/example-package",
	"version": "0.1.0",
	"description": "示例 TS 子项目 —— 验证 conventions extends 是否真正生效",
	"license": "UNLICENSED",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=22.13.0"
	},

	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css",
		"./package.json": "./package.json"
	},

	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],

	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"verify": "pnpm run typecheck && pnpm run lint && pnpm run test"
	},

	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/react": "^19.3.0",
		"jsdom": "^26.0.0",
		"react": "^19.3.0",
		"tsup": "^9.0.0",
		"typescript": "^5.9.3",
		"vitest": "^5.0.5"
	}
}
