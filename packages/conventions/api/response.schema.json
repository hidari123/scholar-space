{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarspace.dev/schemas/response.schema.json",
  "title": "APIResponse",
  "description": "统一响应信封 — 所有 REST 端点必须使用",

  "type": "object",
  "required": ["code", "message", "request_id", "timestamp"],
  "additionalProperties": false,

  "properties": {
    "code": {
      "type": "integer",
      "description": "业务错误码。0 = 成功。其余见 error-codes.json。",
      "default": 0
    },
    "message": {
      "type": "string",
      "description": "人类可读消息。优先为 i18n key（common.error.*）。",
      "default": "ok"
    },
    "data": {
      "description": "业务数据。失败时为 null。",
      "default": null
    },
    "request_id": {
      "type": "string",
      "description": "请求追踪 ID，与日志、链路追踪一致",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "UTC 时间戳"
    }
  }
}
