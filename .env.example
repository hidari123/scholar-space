# scholarspace — 环境变量示例
#
# ⚠️ 真实密钥绝不入库。复制为 .env 后填写。
#    .env 已在 .gitignore 中。

# ── 运行环境 ──────────────────────────────────────────
RUN_ENV=dev                     # dev | staging | prod
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                  # json | console

# ── 服务 ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ── 数据库 ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scholarspace
DB_USER=scholarspace
DB_PASSWORD=change-me
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_SSLMODE=disable               # 生产用 require

# ── 向量（pgvector）────────────────────────────────────
VECTOR_DIM=1536

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── 对象存储 ──────────────────────────────────────────
STORAGE_DRIVER=minio             # local | minio | s3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=scholarspace
MINIO_USE_SSL=false

# ── 鉴权 ──────────────────────────────────────────────
JWT_SECRET=change-me-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=120
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=scholarspace

# ── LLM 网关 ──────────────────────────────────────────
# 至少配置一个 provider
LLM_DEFAULT_PROVIDER=dashscope
LLM_DEFAULT_MODEL=qwen-max

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── 计费 ──────────────────────────────────────────────
BILLING_ENABLED=true
DEFAULT_COINS_PER_YUAN=100
DAILY_BONUS_COIN_LIMIT=300         # 发帖奖励每日上限

# ── 品牌主题 ──────────────────────────────────────────
BRAND_NAME=ScholarSpace
BRAND_PRIMARY_COLOR=#611F6A
BRAND_RADIUS=6
BRAND_MODE=auto
BRAND_LOGO_LIGHT=
BRAND_LOGO_DARK=

# ── 语言 ──────────────────────────────────────────────
DEFAULT_UI_LOCALE=zh-CN
DEFAULT_CONTENT_LANG=auto
SUPPORTED_UI_LOCALES=zh-CN,en-US,zh-TW,zh-HK,ja-JP,ko-KR,fr-FR,de-DE,es-ES,pt-BR,ru-RU,ar-EG

# ── 观测 ──────────────────────────────────────────────
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=scholarspace

# ── 前端（Vite）───────────────────────────────────────
VITE_BRAND_NAME=ScholarSpace
VITE_BRAND_PRIMARY_COLOR=#611F6A
VITE_BRAND_RADIUS=6
VITE_BRAND_MODE=auto
VITE_API_BASE_URL=http://localhost:8000
VITE_SSE_BASE_URL=http://localhost:8000
