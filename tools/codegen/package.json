{
  "name": "@scholarspace/codegen",
  "version": "0.1.0",
  "description": "契约 → 代码生成 —— OpenAPI 到 Python 模型与 TS 客户端",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },

  "bin": {
    "scholarspace-codegen": "./dist/cli.js"
  },

  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "generate": "node ./dist/cli.js generate",
    "diff": "node ./dist/cli.js diff",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },

  "dependencies": {
    "@redocly/cli": "^1.34.5",
    "yaml": "^2.8.1"
  },

  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24.10.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
