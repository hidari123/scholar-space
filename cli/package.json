{
  "name": "@scholarspace/cli",
  "version": "0.1.0",
  "description": "scholarspace 项目脚手架 —— 一条命令生成合规项目",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "scholarspace-cli": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "verify": "npm-run-all --sequential typecheck lint test build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24.10.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "npm-run-all": "^4.1.5"
  }
}
