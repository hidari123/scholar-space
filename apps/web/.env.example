# ⚠️ **环境变量模板** —— 各独立仓用同一份（由 `cli sync` 同步）。
#
# ⚠️ **复制成 `.env.local` 后填实际值**：
#     cp .env.example .env.local
#
# ⚠️ **`.env.local` 不进版本库**（已在 .gitignore 里）。

# ── 各独立站的地址 ─────────────────────────────────────
# ⚠️ **本地开发**：每个站跑在自己的端口
VITE_SITE_IDENTITY_URL=http://localhost:5271
VITE_SITE_PAPER_URL=http://localhost:5272
VITE_SITE_SLIDES_URL=http://localhost:5273
VITE_SITE_ORCHESTRA_URL=http://localhost:5274
VITE_SITE_COMMUNITY_URL=http://localhost:5275

# ── 本站自己的后端 ─────────────────────────────────────
# ⚠️ **留空 = 同源**（生产环境由反向代理处理）
VITE_API_BASE_URL=http://localhost:8000
